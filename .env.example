# Telegram Bot Token (krijg je van @BotFather op Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# OCR MODUS - Kies hoe bonnetjes worden gelezen
# ============================================
# Opties:
#   test      - Fake data, geen API kosten (voor development/testen)
#   tesseract - Gratis lokale OCR (vereist Tesseract installatie)
#   openai    - OpenAI Vision API (beste kwaliteit, ~€0.01-0.03 per bonnetje)
#   auto      - Gebruikt OpenAI als key aanwezig, anders Tesseract
#
# Start met "test" om de bot te testen zonder kosten!
OCR_MODE=test

# OpenAI API Key (alleen nodig voor OCR_MODE=openai of auto)
# Haal je key op: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
